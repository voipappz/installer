# .env — the installer's record of this node, at /opt/voipappz/.env (mode 0600).
#
# NOT read by anything at runtime. There is no Compose here: the node is one
# `docker run`, and the container derives its own environment from the mounted
# config/va.yaml at boot (the `va-env` s6 oneshot runs `voipappz env --export`).
#
# This file exists for two reasons:
#   1. the next install reads it back, so re-installing never rotates a secret
#      the node already uses;
#   2. three values cannot be derived from va.yaml — they are secrets — and the
#      installer passes exactly those to `docker run -e`:
#
#        VA_FREESWITCH_PASSWORD  -e FREESWITCH_PASSWORD  (and VA_FREESWITCH_PASSWORD)
#        VA_LICENSE_JWT_SECRET   -e LICENSE_JWT_SECRET
#        VA_LICENSE_ENCRYPTION_KEY -e LICENSE_ENCRYPTION_KEY
#
# Everything else below is a record of what the node was installed with. To
# change the node, edit config/va.yaml and re-run the installer — editing this
# file changes nothing.

# ── the three secrets the image cannot derive ───────────────────────────────
VA_FREESWITCH_PASSWORD=<generated>     # FreeSWITCH ESL password
VA_LICENSE_JWT_SECRET=<generated>      # without these two the container
VA_LICENSE_ENCRYPTION_KEY=<generated>  # refuses to boot (its preflight says so)

# ── what this node is (all of it also lives in config/va.yaml) ──────────────
VA_NODE_UUID=00000000-0000-0000-0000-000000000002
VA_APP_INTERNAL_IP_ADDRESS=10.0.0.10
VA_APP_EXTERNAL_IP_ADDRESS=203.0.113.10
VA_SIP_PORT=5060                       # kamailio; sofia's 5070/5090 are in va.yaml

# ── where it reports ────────────────────────────────────────────────────────
# Recorded at install. The container reads them from va.yaml, not from here.
# VA_NATS_HOST is the broker's address as it resolved during the install — the
# installer refuses a broker name it cannot resolve, and keeps the answer.
VA_API_URL=https://cloud.voipappz.io
VA_NATS_URL=nats://cloud.voipappz.io:4222
VA_NATS_HOST=203.0.113.20

# ── the image it runs ───────────────────────────────────────────────────────
# `docker run` uses exactly this reference, so a node pinned to a version keeps
# running that version until you install another one.
VA_VOIP_IMAGE=nirlevi/va-crystal:node

# NOTE: the generated file also carries app-plane values — VA_RACK_ENV,
# VA_POSTGRES_*, VA_DATABASE_*, VA_REDIS_URL, VA_S3_*, VA_VAULT_MASTER_KEY,
# SMTP_*. One CLI function writes the environment for both planes from one
# va.yaml schema, so a node gets them too. Nothing on a node reads them.
