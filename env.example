# .env — the Compose environment for one node, GENERATED by the installer.
#
# You do not write this file: `install.sh` derives it from config/va.yaml with
# the node CLI and writes it to /opt/voipappz/.env, mode 0600. It is shown here
# so you can see what Compose reads, and check a value on a running node:
#
#   sudo grep VA_API_URL /opt/voipappz/.env
#
# Secrets are generated ONCE and read back on every later run — re-installing
# never rotates a password a volume already holds. Nothing in this file is a
# credential you supply: the Docker Hub token and the Account key are used
# during the install and never written anywhere.
#
# Values below are placeholders in the shape the installer produces.

# ── this node ───────────────────────────────────────────────────────────────
VA_NODE_UUID=00000000-0000-0000-0000-000000000002
VA_HOSTNAME=node1
VA_APP_INTERNAL_IP_ADDRESS=10.0.0.10        # bind address
VA_APP_EXTERNAL_IP_ADDRESS=203.0.113.10     # advertised address
VA_APP_ADDRESS=10.0.0.10
VA_VOIP_ADDRESS=10.0.0.10
VA_DB_ADDRESS=10.0.0.10

# ── where it reports ────────────────────────────────────────────────────────
# Written by the installer from VA_API_URL / the mothership prompt and from
# va.yaml's broker. VA_NATS_HOST is the resolved address Compose maps `nats`
# to, because Docker refuses a hostname in extra_hosts.
VA_API_URL=https://cloud.voipappz.io
VA_NATS_URL=nats://cloud.voipappz.io:4222
VA_NATS_HOST=203.0.113.20
VA_NATS_URL_API=nats://default:<token>@nats:4222
VA_NATS_TOKEN=<generated>

# ── the image Compose runs ──────────────────────────────────────────────────
# nirlevi/va-crystal:${VA_VOIP_TAG}. The installer sets it to the tag it
# installed, so a node pinned to a version keeps running that version.
VA_VOIP_TAG=node

# ── SIP and media ───────────────────────────────────────────────────────────
VA_SIP_PORT=5060                 # Kamailio (sofia sits on 5070/5090, see va.yaml)
VA_FREESWITCH_PORT=8021          # ESL, loopback only
VA_FREESWITCH_PASSWORD=<generated>
VA_FS_MAX_SPS=2000
VA_FS_MAX_SESSIONS=5000
VA_CPU_CORES=4
VA_EVENTS=CUSTOM,CHANNEL_CREATE,CHANNEL_ANSWER,CHANNEL_HANGUP_COMPLETE

# ── organization and alerts (carried from va.yaml) ──────────────────────────
VA_ORGANIZATION_NAME=ExampleOrg
VA_DOMAIN=pbx.example.com
VA_SSL_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# ── generated secrets (never rotated by a rerun) ────────────────────────────
VA_SECRET_KEY=<generated>
VA_SECRET_KEY_BASE=<generated>
VA_LICENSE_ENCRYPTION_KEY=<generated>
VA_LICENSE_JWT_SECRET=<generated>
VA_VAULT_MASTER_KEY=<generated>
VA_POSTGRES_USERNAME=postgres
VA_POSTGRES_PASSWORD=<generated>
VA_DATABASE_URL=postgres://postgres:<generated>@db:5432/voipappz
VA_DATABASE_KAMAILIO_URL=postgres://postgres:<generated>@db:5432/kamailio
VA_REDIS_URL=redis://:<generated>@redis:6379/0
VA_S3_KEY=<generated>
VA_S3_SECRET=<generated>
VA_S3_REGION=us-east-1
VA_S3_ENDPOINT=http://minio:9000
VA_RACK_ENV=production
