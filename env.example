# .env — /opt/voipappz/.env, mode 0600. Written by the installer, read by the
# installer. Nothing reads it at runtime: the container derives its whole
# environment from config/va.yaml at boot (`voipappz env --export`, the
# `va-env` step), so this file holds only what must NOT be in the YAML and
# what the installer itself needs to remember.

# ── the three secrets the image cannot derive from va.yaml ──────────────────
# Generated once by the node CLI, read back on every later install (a rerun
# never rotates them), and handed to the container with `docker run -e`.
VA_FREESWITCH_PASSWORD=<generated>     # -e FREESWITCH_PASSWORD, -e VA_FREESWITCH_PASSWORD
VA_LICENSE_JWT_SECRET=<generated>      # -e LICENSE_JWT_SECRET
VA_LICENSE_ENCRYPTION_KEY=<generated>  # -e LICENSE_ENCRYPTION_KEY

# ── what the installer runs and where the node reports ──────────────────────
VA_VOIP_IMAGE=nirlevi/va-crystal:node   # exactly what `docker run` starts
VA_API_URL=https://cloud.voipappz.io    # also in va.yaml (mothership.url)
VA_NATS_URL=nats://cloud.voipappz.io:4222   # also in va.yaml (broker.url)
VA_NATS_HOST=203.0.113.20               # the broker's address as it resolved at install

# To change the node, edit config/va.yaml and restart va-voip (or re-run the
# installer). Editing this file changes nothing the node does.
