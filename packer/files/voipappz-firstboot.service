[Unit]
Description=VoIPAppz first boot (retire the build password; install the node if answers were supplied)
# docker must be up before the installer runs. network-online, not just
# network: the installer's setup derives the node's address from the interface
# holding the default route, and cloud-init may still be assigning it when plain
# network.target fires.
After=docker.service network-online.target cloud-init.service
Wants=network-online.target
Requires=docker.service
# Cheap guard so the unit does not even start on subsequent boots; the script
# checks the same stamp itself, because a unit condition is not a lock.
ConditionPathExists=!/var/lib/voipappz/firstboot.done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/voipappz-firstboot
# An unattended install pulls nothing (the image is on disk) but still
# registers the node and waits on its health verdict.
TimeoutStartSec=1800
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
