# .env — the installer's answer file. Copy to .env beside install.sh (or point
# VA_ENV_FILE at it) and run `sh install.sh`: every prompt that has a value
# here is not asked. Mode 0600 — it holds your logins. A variable already in
# the environment wins over this file.
#
# This is the INPUT. The node's own /opt/voipappz/.env is written by the
# installer (its three generated secrets and the image it runs) and is a
# different file.

# ── the mothership and your Account (the node registers with it) ────────────
VA_API_URL=https://mothership.example.com:8000
VA_API_EMAIL=admin@example.com
VA_API_PASSWORD=change-me
# or, instead of e-mail + password, the Account's Basic key:
#VA_API_AUTHORIZATION=Basic <base64 of email:password>

# ── the image ───────────────────────────────────────────────────────────────
# dockerhub (needs the two below) | s3 (the latest published archive) | archive
VA_IMAGE_SOURCE=s3
#VA_REGISTRY_USER=<docker-hub-user>
#VA_REGISTRY_TOKEN=<docker-hub-token>
#VA_IMAGE_ARCHIVE=/absolute/path/va-crystal-node-latest.tar.gz
#VA_VOIP_IMAGE=nirlevi/va-crystal:node

# ── the node ────────────────────────────────────────────────────────────────
# Describe it up front instead of answering the wizard (see va.yaml.example):
#VA_CONFIG=/absolute/path/va.yaml
# Broker, when the YAML has none (default: the mothership host, port 4222):
#VA_NATS_URL=nats://mothership.example.com:4222
# Which customer to link, when the Account sees several:
#VA_CUSTOMER_UUID=
#VA_CUSTOMER_NAME=
# The login of the Account a NEW customer gets (asked otherwise):
#VA_ACCOUNT_EMAIL=owner@example.com
#VA_ACCOUNT_PASSWORD=
# A CA chain for a mothership the node cannot verify (self-signed is pinned
# automatically; this is for a leaf served without its intermediate):
#VA_CA_BUNDLE=/absolute/path/chain.pem

#INSTALL_DIR=/opt/voipappz
#START=0        # install and register, do not start the container
#VA_REGISTER=0  # install and start, do not register
