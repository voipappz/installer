CLAUDE.md
.env

# The real lab file names local paths and customers; the example is the doc.
tests/lab.yml

.claude/

# The CLI build. cli/.gitignore covers its own bin/, lib/ and .shards/; this
# is the copy `make build` puts where consumers run it, and the SIPp the
# scenario commands fetch.
/bin/
.cache/

# The local installation lives in this checkout (INSTALL_DIR=.): its node
# yaml and generated secrets are this host's, never the repository's.
/config/
.env.bak.*
/secrets/
