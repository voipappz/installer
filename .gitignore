CLAUDE.md
.env

# The real lab file names local paths and customers; the example is the doc.
tests/lab.yml

.claude/

# The CLI build. cli/.gitignore covers its own bin/, lib/ and .shards/; this
# is the copy `make build` puts where consumers run it, and the SIPp the
# scenario commands fetch.
/bin/
.cache/

# The local installation lives in this checkout (INSTALL_DIR=.): its node
# yaml and generated secrets are this host's, never the repository's.
/config/
.env.bak.*
/secrets/

# The ISO build. Everything under packer/build/ is generated (the payload, the
# staging tree and the 8GB discs themselves) and packer/cache/ holds the base
# Ubuntu ISO, which is downloaded, not authored. `make iso-clean` clears the
# first without touching the payload.
packer/build/
packer/cache/
packer/crash.log
packer/installer.*.env
